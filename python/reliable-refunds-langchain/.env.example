# Copy to .env and fill in. Do not commit .env.
# The app reads these from the process environment.

# Required
OPENAI_API_KEY=
DBOS_DATABASE_URL=sqlite:///app_db.sqlite

# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=

# Optional. If any of these are missing, approval links are printed to stdout.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ADMIN_EMAIL=

# Optional. Defaults to http://localhost:$PORT
# DBOS_APP_HOSTNAME=http://localhost:8000
# PORT=8000
